RewriteEngine On

   RewriteRule ^articolo/([0-9]+)/?$ articolo.php?id=$1 [L,QSA]
   RewriteRule ^edit/([0-9]+)/?$ edit.php?id=$1 [L,QSA]
   RewriteRule ^rimuovi/([0-9]+)/?$ rimuovi.php?id=$1 [L,QSA]
   RewriteRule ^editMenu/([0-9]+)/?$ editMenu.php?id=$1 [L,QSA]

   # Le tue regole esistenti
   RewriteCond %{REQUEST_FILENAME} !-d
   RewriteCond %{REQUEST_FILENAME}\.php -f
   RewriteRule ^(.*)$ $1.php [L]
   RewriteCond %{REQUEST_FILENAME} !-d
   RewriteCond %{REQUEST_FILENAME}\.html -f
   RewriteRule ^(.*)$ $1.html [L]
# # av:php5-engine
AddHandler av-php82 .php